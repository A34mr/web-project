```gitignore
# Dependencies
node_modules/

# Environment variables
.env
.env.local
.env.*

# Editor/IDE files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Logs
*.log

# Python specific
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
.coverage
coverage/
htmlcov/
.pytest_cache/
.mypy_cache/

# Build outputs
dist/
build/
*.egg-info/
.eggs/

# OS generated files
.DS_Store
Thumbs.db
```