# ── Server Configuration ──
PORT=5000
NODE_ENV=development

# ── MongoDB ──
# IMPORTANT: Replace with your actual credentials. NEVER commit real credentials.
# Use environment variables injected at deploy time in production.
MONGO_URI=mongodb://127.0.0.1:27017/dentai

# ── JWT Secrets ──
# IMPORTANT: Generate a cryptographically random secret (at least 256 bits):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_with_node_e_crypto_randomBytes_32_toString_hex
JWT_REFRESH_SECRET=CHANGE_ME_generate_another_random_32_bytes

# ── Frontend URL ──
FRONTEND_URL=http://localhost:3000
